[Unit]
Description=WeCom channel credential broker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=wecom-channel-alert@%n.service

[Service]
Type=simple
User=wecom-channel
Group=wecom-channel-agents
EnvironmentFile=/etc/wecom-channel/secrets.env
ExecStartPre=/usr/bin/chmod 0750 /run/wecom-channel-agent
ExecStart=/usr/local/bin/wecom-channel-cli broker serve --config /etc/wecom-channel/broker.json
StateDirectory=wecom-channel
StateDirectoryMode=0700
RuntimeDirectory=wecom-channel-agent wecom-channel-admin
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
LimitCORE=0
MemoryMax=256M
TasksMax=64
TimeoutStopSec=70
# Explicit systemctl stop never restarts. Configuration/auth/policy failures
# need repair; crash and unexpected clean exit recovery remain bounded above.
Restart=always
# Go panics also exit 2, so usage/internal exits use the bounded retry budget.
RestartPreventExitStatus=3 4 5 6 10 11
RestartSec=10

[Install]
WantedBy=multi-user.target
