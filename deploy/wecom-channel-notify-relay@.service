[Unit]
Description=Deliver queued WeCom listener %i edge notifications
After=basic.target
OnFailure=wecom-channel-alert@%n.service

[Service]
Type=oneshot
User=wecom-relay
Group=wecom-channel-agents
# Default handler records each edge transition to the local journal/syslog.
# Replace ExecStart (and add EnvironmentFile / AF_INET / AF_INET6 if needed) in
# an operator-owned drop-in to attach a remote notification transport.
ExecStart=/usr/local/bin/wecom-channel-cli relay notify --outbox /var/lib/wecom-health-relay-%i/outbox --lock /run/wecom-notify-relay-%i/notify.lock --exec /usr/bin/logger -- --priority daemon.err --tag wecom-channel-alert
RuntimeDirectory=wecom-notify-relay-%i
RuntimeDirectoryMode=0700
TimeoutStartSec=60
TimeoutStopSec=5
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=-/var/lib/wecom-health-relay-%i/outbox
InaccessiblePaths=-/var/lib/wecom-relay-%i -/var/lib/wecom-relay -/etc/wecom-relay -/etc/wecom-channel
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
LimitCORE=0
MemoryMax=128M
TasksMax=32
StandardOutput=journal
StandardError=journal
