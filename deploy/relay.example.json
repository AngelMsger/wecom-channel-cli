{
  "version": 1,
  "webhook_url": "http://127.0.0.1:8787/wecom-events",
  "token_env": "WECOM_RELAY_TOKEN",
  "kinds": ["topic_event", "topic_reply_event"],
  "changes": [1, 2, 3],
  "exclude_self": true,
  "exclude_bots": [],
  "batch_window_seconds": 5,
  "batch_size": 50,
  "queue_limit": 1000,
  "timeout_seconds": 30,
  "retry_limit": 5,
  "retry_base_seconds": 5
}
