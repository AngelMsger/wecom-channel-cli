[Unit]
Description=Check expected WeCom listener %i
After=basic.target
OnFailure=wecom-channel-alert@%n.service

[Service]
Type=oneshot
User=wecom-relay
Group=wecom-channel-agents
ExecStart=/usr/local/bin/wecom-channel-cli relay check --instance %i --alert-state /var/lib/wecom-health-relay-%i/probe-state.json --outbox /var/lib/wecom-health-relay-%i/outbox
# Exit 11 (LISTENER_UNHEALTHY) preserves real check results while letting
# edge-triggered outbox notifications replace per-probe OnFailure wakeups.
# Probe execution errors, timeouts, and storage failures still trigger OnFailure.
SuccessExitStatus=11
StateDirectory=wecom-health-relay-%i
StateDirectoryMode=0700
TimeoutStartSec=50
TimeoutStopSec=5
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadOnlyPaths=-/var/lib/wecom-relay-%i
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
LimitCORE=0
MemoryMax=128M
TasksMax=32
StandardOutput=journal
StandardError=journal
