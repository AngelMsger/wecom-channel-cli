[Unit]
Description=Check expected WeCom listener %i
After=basic.target
OnFailure=wecom-channel-alert@%n.service

[Service]
Type=oneshot
User=wecom-relay
Group=wecom-channel-agents
ExecStart=/usr/bin/python3 -I /usr/local/libexec/wecom-channel-check-listener.py %i
TimeoutStartSec=50
TimeoutStopSec=5
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadOnlyPaths=-/var/lib/wecom-relay-%i
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
LimitCORE=0
MemoryMax=128M
TasksMax=32
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
