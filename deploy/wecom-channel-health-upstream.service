[Unit]
Description=WeCom channel upstream health probe
After=wecom-channel-broker.service
OnFailure=wecom-channel-alert@%n.service

[Service]
Type=oneshot
User=wecom-channel
Group=wecom-channel-agents
ExecStart=/usr/bin/python3 -I /usr/local/libexec/wecom-channel-check-health.py upstream /run/wecom-channel-admin/admin.sock
TimeoutStartSec=135
TimeoutStopSec=5
KillMode=control-group
Restart=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
LimitCORE=0
MemoryMax=128M
TasksMax=32
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
